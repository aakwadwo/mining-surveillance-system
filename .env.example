# TEMPLATE - copy to .env and fill in.
#     cp .env.example .env
#
# .env is git-ignored; this template is committed so anyone cloning the
# project knows which variables to set.
#
# A browser Google Maps key cannot be kept secret - it is sent to every
# visitor's browser. Protect it in Google Cloud Console instead:
#   1. Credentials > your key > Application restrictions > HTTP referrers
#        http://localhost:5501/*
#   2. API restrictions > Maps JavaScript API, Geocoding API, Places API
#   3. Billing > Budgets & alerts > low daily cap
GOOGLE_MAPS_API_KEY=
